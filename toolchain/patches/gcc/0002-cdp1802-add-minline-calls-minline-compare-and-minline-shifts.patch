+;; Shifts by a constant, expanded inline with -minline-shifts.  DF and D
+;; are clobbered, as by the library routines.
+(define_insn "ashlhi3_const"
+  [(set (match_operand:HI 0 "register_operand" "=c")
+	(ashift:HI (match_operand:HI 1 "register_operand" "0")
+		   (match_operand:HI 2 "const_int_operand" "n")))
+  ]
+  "TARGET_INLINE_SHIFTS"
+  "* return cdp1802_output_shift_const (ASHIFT, operands);"
+  [(set (attr "length")
+	(symbol_ref "cdp1802_shift_const_length (ASHIFT, operands)"))])
+
+(define_insn "lshrhi3_const"
+  [(set (match_operand:HI 0 "register_operand" "=c")
+	(lshiftrt:HI (match_operand:HI 1 "register_operand" "0")
+		     (match_operand:HI 2 "const_int_operand" "n")))
+  ]
+  "TARGET_INLINE_SHIFTS"
+  "* return cdp1802_output_shift_const (LSHIFTRT, operands);"
+  [(set (attr "length")
+	(symbol_ref "cdp1802_shift_const_length (LSHIFTRT, operands)"))])
+
+(define_insn "ashrhi3_const"
+  [(set (match_operand:HI 0 "register_operand" "=c")
+	(ashiftrt:HI (match_operand:HI 1 "register_operand" "0")
+		     (match_operand:HI 2 "const_int_operand" "n")))
+  ]
+  "TARGET_INLINE_SHIFTS"
+  "* return cdp1802_output_shift_const (ASHIFTRT, operands);"
+  [(set (attr "length")
+	(symbol_ref "cdp1802_shift_const_length (ASHIFTRT, operands)"))])
+
 ;; ::::::::::::::::::::
 ;; ::
 ;; :: 16-Bit Integer Logical operations
@@ -709,7 +747,7 @@
   [(set (pc)
 	(if_then_else (match_operator 0 "comparison_operator"
 			[(match_operand:HI 1 "register_operand" "a")
-			 (match_operand:HI 2 "register_operand" "b")])
+			 (match_operand:HI 2 "cdp1802_compare_operand" "b")])
 		      (label_ref (match_operand 3 "" ""))
