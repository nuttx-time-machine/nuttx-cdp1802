diff --git a/gcc/config/cdp1802/cdp1802.opt b/gcc/config/cdp1802/cdp1802.opt
index ffa6f1833..ba42270ef 100644
--- a/gcc/config/cdp1802/cdp1802.opt
+++ b/gcc/config/cdp1802/cdp1802.opt
@@ -25,3 +25,15 @@ Mask(1804)
 march=
 Target RejectNegative Joined Var(cdp1802_arch_option)
 -march=ARCH	Generate code for the specified CDP1802 family member.
+
+minline-calls
+Target Mask(INLINE_CALLS)
+Call functions at known addresses with an inline push of the return address and a long branch, instead of the NCRT call routine (faster; 6 bytes larger per call).
+
+minline-compare
+Target Mask(INLINE_COMPARE)
+Expand 16-bit comparisons inline instead of calling the __cmphi_* routines (faster, larger).
+
+minline-shifts
+Target Mask(INLINE_SHIFTS)
+Expand 16-bit shifts by a constant inline instead of calling __ashlhi3, __lshrhi3 or __ashrhi3 (faster, larger for most shift counts).
