+/* Interrupt-safe updates of the stack pointer.
+
+   The CDP1802 cannot write a 16-bit register in one instruction: R2 (SP) is
+   changed one byte at a time with PLO and PHI.  An interrupt taken between
+   the two writes enters the handler with X=2, and a standard handler saves
+   the context by pushing through R2 (RCA MPM-201A, Fig. 76).  Every
+   intermediate value of R2 must therefore be at or below the live stack
+   top, so that the handler's pushes land in free stack space and never in a
+   live frame.  The sequences below guarantee that each intermediate value
+   is below both the old and the new SP, by less than 512 bytes (the stack
+   "guard band"), provided no stack lives in the lowest 256-byte page, where
+   the arithmetic would wrap.  */
+
+bool
+cdp1802_sp_reg_p (rtx x)
+{
+  return REG_P (x) && REGNO (x) == STACK_POINTER_REGNUM;
+}
+
+/* Split the constant added to SP by an addhi3 (ADD_P) or subhi3 insn into
+   the high and low bytes of the 16-bit two's complement addend.  */
+
+static void
+cdp1802_sp_addend (bool add_p, rtx amount, int *hi, int *lo)
+{
+  unsigned int v = (unsigned int) (add_p ? INTVAL (amount) : -INTVAL (amount));
+
+  *hi = (v >> 8) & 0xff;
+  *lo = v & 0xff;
+}
+
+/* Worker function for the immediate alternative of addhi3 and subhi3.
+
+   For SP += V (V = HI * 256 + LO, modulo 65536):
+   - 0 <= V < 256: add LO to the low byte first, then propagate the carry;
+     the intermediate value is the final one or 256 below it;
+   - LO == 0: a single PHI;
+   - otherwise add HI to the high byte first (the intermediate value is the
+     final one minus LO), then add LO as above.  */
+
+const char *
+cdp1802_template_addhi3_imm (bool add_p, rtx *operands)
+{
+  static char buf[128];
+  int hi, lo;
+
+  if (!cdp1802_sp_reg_p (operands[0]))
+    return (add_p
+	    ? "glo %1\n\tadi %L2\n\tplo %0\n\tghi %1\n\tadci %H2\n\tphi %0"
+	    : "glo %1\n\tsmi %L2\n\tplo %0\n\tghi %1\n\tsmbi %H2\n\tphi %0");
+
+  cdp1802_sp_addend (add_p, operands[2], &hi, &lo);
+  if (hi == 0)
+    snprintf (buf, sizeof buf,
+	      "glo 2\n\tadi 0x%02x\n\tplo 2\n\tghi 2\n\tadci 0\n\tphi 2", lo);
+  else if (lo == 0)
+    snprintf (buf, sizeof buf, "ghi 2\n\tadi 0x%02x\n\tphi 2", hi);
+  else
+    snprintf (buf, sizeof buf,
+	      "ghi 2\n\tadi 0x%02x\n\tphi 2\n\t"
+	      "glo 2\n\tadi 0x%02x\n\tplo 2\n\tghi 2\n\tadci 0\n\tphi 2", hi, lo);
+  return buf;
+}
+
+/* Length of the above.  */
+
+int
+cdp1802_length_addhi3_imm (bool add_p, rtx *operands)
+{
+  int hi, lo;
+
+  if (!cdp1802_sp_reg_p (operands[0]))
+    return 8;
+  cdp1802_sp_addend (add_p, operands[2], &hi, &lo);
+  return hi == 0 ? 8 : lo == 0 ? 4 : 12;
+}
+
+/* Worker function for the register-to-register alternative of movhi.
+   When the destination is SP and the direction of the change is unknown,
+   first make SP point one page below the new value (keeping the old low
+   byte), then write the low byte and finally the high byte.  Every
+   intermediate value is below the new SP.  */
+
+const char *
+cdp1802_template_movhi_r_r (rtx dst)
+{
+  if (cdp1802_sp_reg_p (dst))
+    return "ghi %1\n\tsmi 1\n\tphi %0\n\tglo %1\n\tplo %0\n\tghi %1\n\tphi %0";
+  return "ghi %1\n\tphi %0\n\tglo %1\n\tplo %0";
+}
+
+/* Worker function for the immediate alternative of movhi; as above.  */
+
+const char *
+cdp1802_template_movhi_r_i (rtx dst)
+{
+  if (cdp1802_sp_reg_p (dst))
+    return "ldi %H1\n\tsmi 1\n\tphi %0\n\tldi %L1\n\tplo %0\n\tldi %H1\n\tphi %0";
+  return "ldi %H1\n\tphi %0\n\tldi %L1\n\tplo %0";
+}
+
+/* Worker function for the memory-to-register alternatives of movhi
+   (KIND 'S': post-increment, 'T': post-decrement, 'm': plain; TEMPL is the
+   ordinary sequence).  Loading SP from memory happens in non-local exits,
+   e.g. libgcc's SJLJ unwinder.  As above, first make SP point one page
+   below the new value, then write the low and the high byte; the pointer
+   register ends where the ordinary sequence leaves it.  */
+
+const char *
+cdp1802_template_movhi_r_m (rtx dst, rtx src, char kind, const char *templ)
+{
+  if (!cdp1802_sp_reg_p (dst))
+    return templ;
+
+  /* The address is (post_inc R), (post_dec R) or R.  */
+  rtx base = kind == 'm' ? XEXP (src, 0) : XEXP (XEXP (src, 0), 0);
+  if (!REG_P (base) || cdp1802_sp_reg_p (base))
+    error ("cdp1802: cannot load the stack pointer from this address");
+
+  switch (kind)
+    {
+    case 'S':
+      return ("lda %M1\n\tsmi 1\n\tphi 2\n\tlda %M1\n\tplo 2\n\t"
+	      "dec %M1\n\tdec %M1\n\tlda %M1\n\tphi 2\n\tinc %M1");
+    case 'T':
+      return ("lda %M1\n\tsmi 1\n\tphi 2\n\tldn %M1\n\tplo 2\n\t"
+	      "dec %M1\n\tldn %M1\n\tphi 2\n\tdec %M1\n\tdec %M1");
+    default:
+      return ("lda %M1\n\tsmi 1\n\tphi 2\n\tldn %M1\n\tplo 2\n\t"
+	      "dec %M1\n\tldn %M1\n\tphi 2");
+    }
+}
+
 /* Worker function for movdf_internal insn.
 
    Adjust the copying order to avoid clobbering the value being copied.  */
